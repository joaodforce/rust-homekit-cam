[Unit]
Description=rust-homekit-cam - UniFi Protect doorbell as a HomeKit accessory
After=network-online.target
Wants=network-online.target

[Service]
# The config (secrets, root-only 0600) is handed to the dynamic user as a credential.
LoadCredential=config:/etc/rust-homekit-cam.toml
ExecStart=/usr/local/bin/rust-homekit-cam serve ${CREDENTIALS_DIRECTORY}/config
Restart=always
RestartSec=2
DynamicUser=yes
StateDirectory=rust-homekit-cam
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
